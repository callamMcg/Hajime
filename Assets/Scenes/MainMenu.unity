  m_Script: {fileID: 11500000, guid: 8a9b90099fc570b4fb5dd637c5ef3247, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TechniquesScreen
  firstSelected: {fileID: 0}
  fadeDuration: 0.2
  techniques:
  - name: De Ashi Barai
    jap: "\u51FA\u8DB3\u6255"
    description: forward foot sweep
    steps:
    - Pull the uke to cause them to step and bounce.
    - As they step press kuzushi to lift the uke higher and off balance them.
    - Soon after kuzushi, press sweep using the opposite side to the direction you
      are pulling the uke.
    - Hold the sweep until they tip past their balance and fall.
    - IPPON!
  nameLabel: {fileID: 1716494807}
  japLabel: {fileID: 1459035708}
  descriptionLabel: {fileID: 454769034}
  stepsArea: {fileID: 1705767119}
