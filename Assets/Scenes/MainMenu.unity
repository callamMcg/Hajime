      m_Calls: []
  m_text: 'Pull the uke to cause them to step and bounce.

    As they step press
    kuzushi to lift the uke higher and off balance them.

    Soon after kuzushi,
    press sweep using the opposite side to the direction you are pulling the uke.

    Hold
    the sweep until they tip past their balance and fall.

    IPPON!

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6de2e27878aa7d2479335623eaf68216, type: 2}
