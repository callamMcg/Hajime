MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8260256194062344708}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a9b90099fc570b4fb5dd637c5ef3247, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TechniquesScreen
  firstSelected: {fileID: 0}
  fadeDuration: 0.2
  techniques:
  - name: De Ashi Barai
    jap: "\u51FA\u8DB3\u6255"
    description: forward foot sweep
    steps:
    - Pull the uke to cause them to step and bounce.
    - As they lift their foot trailing foot press and hold sweep the direction you
      are pulling.
    - Push their foot from under them until they fall.
  - name: Hiza Guruma
    jap: "\u819D\u8ECA"
    description: Knee Wheel
    steps:
    - Pull the uke to cause them to step and bounce.
    - As they plant their lead foot press and hold sweep against the direciton you
      are pulling.
    - Stop their foot from moving and pull them past their foot.
  - name: Tomoe Nage
    jap: "\u5DF4\u6295"
    description: Sacrifice Throw (Dev)
    steps:
    - Hold the uke still.
    - Press both throw buttons.
    - Drop to your back, place your feet on their hips, and throw them over your
      head.
  - name: Harai Goshi
    jap: "\u6255\u8170"
    description: Sweeping Hip Throw
    steps:
    - Pull the uke to cause them to step and bounce.
    - As they lift their foot trailing foot press and throw the direction you are
      pulling.
    - Turn your back to your opponent and throw them over your hip as you sweep their
      leg.
  nameLabel: {fileID: 6020586838892270284}
  japLabel: {fileID: 5273727797136827210}
  descriptionLabel: {fileID: 8724571625389906270}
  stepsArea: {fileID: 9087728230921887615}
